# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: comma-separated model list, tried in order until one answers.
# Defaults to two free-tier Gemma models with paid Gemini Flash as last resort.
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,google/gemini-2.5-flash
