    <rdfs:subClassOf rdf:resource="#IPRLicense"/>
  </owl:Class>
  <owl:Class rdf:ID="Royalty">
    <rdfs:comment/>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Quantity"/>
    </rdfs:subClassOf>
    <rdfs:label>Royalty</rdfs:label>
