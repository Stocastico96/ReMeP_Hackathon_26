    <rdfs:label>NeighbouringRight</rdfs:label>
    <rdfs:subClassOf rdf:resource="#IntellectualPropertyRight"/>
  </owl:Class>
  <owl:Class rdf:ID="Organization">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Party"/>
    </rdfs:subClassOf>
    <rdfs:label>Organization</rdfs:label>
