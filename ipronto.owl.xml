  <owl:Class rdf:ID="TimeMeasure">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Quantity"/>
    </rdfs:subClassOf>
    <rdfs:label>TimeMeasure</rdfs:label>
    <rdfs:comment/>
  </owl:Class>
  <owl:Class rdf:ID="CurrencyMeasure">
