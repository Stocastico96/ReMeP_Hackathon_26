    <rdfs:subClassOf>
      <owl:Class rdf:about="#TransformationRight"/>
    </rdfs:subClassOf>
    <rdfs:label>AdaptationRight</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="PurchaseContract">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#IPRContract"/>
    </rdfs:subClassOf>
